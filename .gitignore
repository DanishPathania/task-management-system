# Version control ignore file

# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with 'go test -c'
*.test

# Output of the go coverage tool, specifically when used with LiteIDE
*.out

# Go workspace file
go.work

# Node.js
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Next.js build
.next/
out/
build/
dist/

# Environment files — NEVER commit real secrets
.env
.env.local
.env.production
.env.staging
.env.development.local
.env.test.local
.env.production.local
.env.*.local
secrets/
*.pem
*.key
*.crt
*.pfx

# Uploads (user data)
uploads/
backend/uploads/

# Backend build output
backend/bin/

# IDEs
.idea/
.vscode/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db
