# ============================================================
# PRODUCTION Environment Variables — EXAMPLE FILE
# Copy to .env.production and fill in real values.
# NEVER commit .env.production to source control.
# ============================================================

# ---- Reverse Proxy (Caddy) ----
# For IP-based HTTP access (no domain yet), prefix with http://:
#   SERVER_HOST=http://1.2.3.4
# For a custom domain with automatic HTTPS (Let's Encrypt), omit http://:
#   SERVER_HOST=app.example.com
SERVER_HOST=http://YOUR_SERVER_IP

# ---- Server ----
SERVER_PORT=8080
SERVER_ENV=production
LOG_LEVEL=info

# ---- Database ----
# Replace with your actual PostgreSQL credentials.
# POSTGRES_USER, POSTGRES_PASSWORD, and POSTGRES_DB must match DATABASE_URL.
# Keep sslmode=disable for the internal Docker postgres container (no TLS inside bridge network).
POSTGRES_USER=CHANGEME_USER
POSTGRES_PASSWORD=CHANGEME_PASSWORD
POSTGRES_DB=taskdb
DATABASE_URL=postgres://CHANGEME_USER:CHANGEME_PASSWORD@postgres:5432/taskdb?sslmode=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME=5m

# ---- Redis ----
# Generate a strong password with: openssl rand -hex 24
REDIS_URL=redis://redis:6379/0
REDIS_PASSWORD=CHANGEME_REDIS_PASSWORD

# ---- JWT ----
# REQUIRED: Generate with: openssl rand -hex 32 (minimum 32 characters)
JWT_SECRET=CHANGEME_REPLACE_WITH_STRONG_RANDOM_64_CHAR_HEX_STRING
JWT_EXPIRATION_HOURS=24

# ---- Cookies ----
# Set COOKIE_SECURE=true when serving over HTTPS (after you have a domain/TLS).
# Set to false ONLY when using plain HTTP (IP-only deployments).
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
COOKIE_DOMAIN=

# ---- CORS ----
# Replace with your actual domain or server IP (the URL your users open in their browser).
# Examples:
#   IP-based:    CORS_ALLOWED_ORIGINS=http://1.2.3.4
#   Domain:      CORS_ALLOWED_ORIGINS=https://app.example.com
CORS_ALLOWED_ORIGINS=http://YOUR_SERVER_IP

# ---- File Uploads ----
UPLOAD_DIR=/app/uploads

# ---- Frontend build-time (used by docker-compose.prod.yml build args) ----
# Replace with the public URL of your backend API — what a user's browser sends requests to.
# IP-based example:   http://1.2.3.4/api/v1
# Domain example:     https://app.example.com/api/v1
NEXT_PUBLIC_API_URL=http://YOUR_SERVER_IP/api/v1
NEXT_PUBLIC_WS_URL=ws://YOUR_SERVER_IP/api/v1/ws
